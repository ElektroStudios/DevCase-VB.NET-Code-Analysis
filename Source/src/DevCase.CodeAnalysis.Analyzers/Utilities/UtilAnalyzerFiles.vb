#Region " Option Statements "

Option Strict On
Option Explicit On
Option Infer Off

#End Region

#Region " Imports "

Imports System.Collections.Immutable
Imports System.Linq
Imports System.Runtime.CompilerServices

Imports Microsoft.CodeAnalysis
Imports Microsoft.CodeAnalysis.Diagnostics

#End Region

#Region " UtilAnalyzerFiles "

Namespace DevCase.Core.Diagnostics.Dotnet.CodeAnalysis.Analyzers

    ''' <summary>
    ''' Decides which source files every DevCase analyzer ignores, and wraps the analysis actions so that they never run on them.
    ''' </summary>
    '''
    ''' <remarks>
    ''' Every analyzer registers its actions through <see cref="SkipExcludedNodes"/>, <see cref="SkipExcludedOperations"/>,
    ''' <see cref="SkipExcludedSymbols"/> or <see cref="SkipExcludedTrees"/>. Roslyn already skips the files that it recognizes
    ''' as generated (by name, or by an <c>&lt;auto-generated&gt;</c> header), because every analyzer configures
    ''' <see cref="GeneratedCodeAnalysisFlags.None"/>; this filter also covers files without such a header, such as
    ''' <c>AssemblyInfo.vb</c> and <c>GlobalSuppressions.vb</c>.
    ''' </remarks>
    Friend NotInheritable Class UtilAnalyzerFiles

#Region " Fields "

        ''' <summary>
        ''' The file name patterns of the ignored source files. A file is ignored when its name ends with one of these
        ''' patterns immediately followed by its own extension (case-insensitive): <c>.Designer</c> ignores <c>Form1.Designer.vb</c>
        ''' and <c>Form1.Designer.cs</c>.
        ''' </summary>
        '''
        ''' <remarks>
        ''' <list type="bullet">
        '''   <item><description><c>.Designer</c>: designer files (<c>Form1.Designer.vb</c>, <c>Resources.Designer.vb</c>, <c>Settings.Designer.vb</c>).</description></item>
        '''   <item><description><c>.AssemblyAttributes</c>: generated assembly attributes (<c>.NETFramework,Version=v4.8.AssemblyAttributes.vb</c>).</description></item>
        '''   <item><description><c>AssemblyInfo</c>: assembly metadata (<c>My Project\AssemblyInfo.vb</c>, <c>MyApp.AssemblyInfo.vb</c>).</description></item>
        '''   <item><description><c>GlobalSuppressions</c>: suppression attributes (<c>GlobalSuppressions.vb</c>, <c>GlobalSuppressions.cs</c>).</description></item>
        '''   <item><description><c>.g</c>, <c>.g.i</c>: files emitted by XAML, Razor and source generators (<c>MainWindow.g.vb</c>, <c>App.g.i.vb</c>).</description></item>
        '''   <item><description><c>.generated</c>: files marked as generated by tools or templates (<c>Reference.generated.vb</c>).</description></item>
        ''' </list>
        ''' </remarks>
        Friend Shared ReadOnly ExcludedFileNamePatterns As ImmutableArray(Of String) =
            ImmutableArray.Create(".Designer", ".AssemblyAttributes", "AssemblyInfo", "GlobalSuppressions", ".g", ".g.i", ".generated")

        ''' <summary>
        ''' The file name prefix of the temporary files generated by the build (<c>TemporaryGeneratedFile_*.vb</c>,
        ''' emitted by WPF and Workflow projects in the <c>obj</c> folder).
        ''' </summary>
        Friend Const ExcludedFileNamePrefix As String = "TemporaryGeneratedFile_"

        ''' <summary>
        ''' The cached result of <see cref="IsExcluded"/> for each syntax tree (the analysis actions run many times per tree).
        ''' </summary>
        Private Shared ReadOnly Cache As New ConditionalWeakTable(Of SyntaxTree, StrongBox(Of Boolean))()

#End Region

#Region " Constructors "

        ''' <summary>
        ''' Prevents a default instance of the <see cref="UtilAnalyzerFiles"/> class from being created.
        ''' </summary>
        Private Sub New()
        End Sub

#End Region

#Region " Friend Methods "

        ''' <summary>
        ''' Determines whether a file path is ignored by the analyzers (see <see cref="ExcludedFileNamePatterns"/>).
        ''' </summary>
        '''
        ''' <param name="filePath">
        ''' The file path. May be empty (an in-memory document): it is never ignored.
        ''' </param>
        '''
        ''' <returns>
        ''' <see langword="True"/> if the file is ignored; otherwise, <see langword="False"/>.
        ''' </returns>
        Friend Shared Function IsExcludedFilePath(filePath As String) As Boolean

            If String.IsNullOrEmpty(filePath) Then
                Return False
            End If

            ' Both separators: the path may come from Windows while the analyzer runs on another platform (and vice versa).
            Dim fileName As String = filePath.Substring(Math.Max(filePath.LastIndexOf("\"c), filePath.LastIndexOf("/"c)) + 1)
            Dim dot As Integer = fileName.LastIndexOf("."c)
            Dim extension As String = If(dot < 0, String.Empty, fileName.Substring(dot))
            If fileName.StartsWith(UtilAnalyzerFiles.ExcludedFileNamePrefix, StringComparison.OrdinalIgnoreCase) Then
                Return True
            End If
            For Each pattern As String In UtilAnalyzerFiles.ExcludedFileNamePatterns
                If fileName.EndsWith($"{pattern}{extension}", StringComparison.OrdinalIgnoreCase) Then
                    Return True
                End If
            Next pattern
            Return False
        End Function

        ''' <summary>
        ''' Determines whether a syntax tree is ignored by the analyzers.
        ''' </summary>
        '''
        ''' <param name="tree">
        ''' The syntax tree.
        ''' </param>
        '''
        ''' <returns>
        ''' <see langword="True"/> if the file of the tree is ignored; otherwise, <see langword="False"/>.
        ''' </returns>
        '''
        ''' <exception cref="ArgumentNullException">
        ''' Thrown when <paramref name="tree"/> is <see langword="Nothing"/>.
        ''' </exception>
        Friend Shared Function IsExcluded(tree As SyntaxTree) As Boolean

            If tree Is Nothing Then
                Throw New ArgumentNullException(NameOf(tree))
            End If

            Return UtilAnalyzerFiles.Cache.GetValue(tree, Function(t As SyntaxTree) New StrongBox(Of Boolean)(UtilAnalyzerFiles.IsExcludedFilePath(t.FilePath))).Value
        End Function

        ''' <summary>
        ''' Wraps a syntax node action so that it does not run on ignored files.
        ''' </summary>
        '''
        ''' <param name="action">
        ''' The action.
        ''' </param>
        '''
        ''' <returns>
        ''' The wrapped action.
        ''' </returns>
        '''
        ''' <exception cref="ArgumentNullException">
        ''' Thrown when <paramref name="action"/> is <see langword="Nothing"/>.
        ''' </exception>
        Friend Shared Function SkipExcludedNodes(action As Action(Of SyntaxNodeAnalysisContext)) As Action(Of SyntaxNodeAnalysisContext)

            If action Is Nothing Then
                Throw New ArgumentNullException(NameOf(action))
            End If

            Return Sub(context As SyntaxNodeAnalysisContext)
                       If Not UtilAnalyzerFiles.IsExcluded(context.Node.SyntaxTree) Then
                           action(context)
                       End If
                   End Sub
        End Function

        ''' <summary>
        ''' Wraps an operation action so that it does not run on ignored files.
        ''' </summary>
        '''
        ''' <param name="action">
        ''' The action.
        ''' </param>
        '''
        ''' <returns>
        ''' The wrapped action.
        ''' </returns>
        '''
        ''' <exception cref="ArgumentNullException">
        ''' Thrown when <paramref name="action"/> is <see langword="Nothing"/>.
        ''' </exception>
        Friend Shared Function SkipExcludedOperations(action As Action(Of OperationAnalysisContext)) As Action(Of OperationAnalysisContext)

            If action Is Nothing Then
                Throw New ArgumentNullException(NameOf(action))
            End If

            Return Sub(context As OperationAnalysisContext)
                       If Not UtilAnalyzerFiles.IsExcluded(context.Operation.Syntax.SyntaxTree) Then
                           action(context)
                       End If
                   End Sub
        End Function

        ''' <summary>
        ''' Wraps a symbol action so that it does not run on symbols declared only in ignored files.
        ''' </summary>
        '''
        ''' <param name="action">
        ''' The action.
        ''' </param>
        '''
        ''' <returns>
        ''' The wrapped action.
        ''' </returns>
        '''
        ''' <remarks>
        ''' A symbol declared in several files (a partial type) is still analyzed when one of its declarations is in an analyzed file.
        ''' </remarks>
        '''
        ''' <exception cref="ArgumentNullException">
        ''' Thrown when <paramref name="action"/> is <see langword="Nothing"/>.
        ''' </exception>
        Friend Shared Function SkipExcludedSymbols(action As Action(Of SymbolAnalysisContext)) As Action(Of SymbolAnalysisContext)

            If action Is Nothing Then
                Throw New ArgumentNullException(NameOf(action))
            End If

            Return Sub(context As SymbolAnalysisContext)
                       Dim references As ImmutableArray(Of SyntaxReference) = context.Symbol.DeclaringSyntaxReferences
                       Dim allExcluded As Boolean = Not references.IsEmpty AndAlso
                                                    references.All(Function(r As SyntaxReference) UtilAnalyzerFiles.IsExcluded(r.SyntaxTree))
                       If Not allExcluded Then
                           action(context)
                       End If
                   End Sub
        End Function

        ''' <summary>
        ''' Wraps a syntax tree action so that it does not run on ignored files.
        ''' </summary>
        '''
        ''' <param name="action">
        ''' The action.
        ''' </param>
        '''
        ''' <returns>
        ''' The wrapped action.
        ''' </returns>
        '''
        ''' <exception cref="ArgumentNullException">
        ''' Thrown when <paramref name="action"/> is <see langword="Nothing"/>.
        ''' </exception>
        Friend Shared Function SkipExcludedTrees(action As Action(Of SyntaxTreeAnalysisContext)) As Action(Of SyntaxTreeAnalysisContext)

            If action Is Nothing Then
                Throw New ArgumentNullException(NameOf(action))
            End If

            Return Sub(context As SyntaxTreeAnalysisContext)
                       If Not UtilAnalyzerFiles.IsExcluded(context.Tree) Then
                           action(context)
                       End If
                   End Sub
        End Function

#End Region

    End Class

End Namespace

#End Region
