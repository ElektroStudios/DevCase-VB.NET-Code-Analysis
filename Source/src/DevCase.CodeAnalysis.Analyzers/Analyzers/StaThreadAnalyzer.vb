#Region " Option Statements "

Option Strict On
Option Explicit On
Option Infer Off

#End Region

#Region " Imports "

Imports System.Collections.Immutable
Imports System.Linq

Imports Microsoft.CodeAnalysis
Imports Microsoft.CodeAnalysis.Diagnostics

#End Region

#Region " StaThreadAnalyzer "

Namespace DevCase.Core.Diagnostics.Dotnet.CodeAnalysis.Analyzers

    ''' <summary>
    ''' Reports a <c>Sub Main</c> entry point without <c>&lt;STAThread&gt;</c> in projects that reference Windows Forms 
    ''' (rule <see cref="DiagnosticIds.MissingStaThread"/>).
    ''' </summary>
    ''' 
    ''' <remarks>
    ''' A method is considered an entry point when it is a <see langword="Shared"/> (or module) method named <c>Main</c>, 
    ''' without type parameters, that returns nothing or <see cref="Integer"/>, and takes no parameters or one <see cref="String"/> array. 
    ''' Methods marked with <c>&lt;MTAThread&gt;</c> are not reported: that is an explicit decision. 
    ''' The <c>Sub Main</c> generated by the Visual Basic application framework is generated code and is already marked.
    ''' </remarks>
    <DiagnosticAnalyzer(LanguageNames.VisualBasic)>
    Public NotInheritable Class StaThreadAnalyzer : Inherits DiagnosticAnalyzer

#Region " Properties "

        ''' <inheritdoc/>
        Public Overrides ReadOnly Property SupportedDiagnostics As ImmutableArray(Of DiagnosticDescriptor)
            Get
                Return ImmutableArray.Create(DevCaseDescriptors.MissingStaThread)
            End Get
        End Property

#End Region

#Region " Constructors "

        ''' <summary>
        ''' Initializes a new instance of the <see cref="StaThreadAnalyzer"/> class.
        ''' </summary>
        Public Sub New()
        End Sub

#End Region

#Region " Public Methods "

        ''' <inheritdoc/>
        Public Overrides Sub Initialize(context As AnalysisContext)

            If context Is Nothing Then
                Throw New ArgumentNullException(NameOf(context))
            End If

            context.ConfigureGeneratedCodeAnalysis(GeneratedCodeAnalysisFlags.None)
            context.EnableConcurrentExecution()
            context.RegisterCompilationStartAction(AddressOf StaThreadAnalyzer.OnCompilationStart)
        End Sub

#End Region

#Region " Private Methods "

        ''' <summary>
        ''' Resolves the Windows Forms and apartment attribute types, and registers the symbol action when Windows Forms is referenced.
        ''' </summary>
        ''' 
        ''' <param name="context">
        ''' The compilation start analysis context.
        ''' </param>
        Private Shared Sub OnCompilationStart(context As CompilationStartAnalysisContext)

            Dim applicationType As INamedTypeSymbol = context.Compilation.GetTypeByMetadataName("System.Windows.Forms.Application")
            Dim staType As INamedTypeSymbol = context.Compilation.GetTypeByMetadataName("System.STAThreadAttribute")
            Dim mtaType As INamedTypeSymbol = context.Compilation.GetTypeByMetadataName("System.MTAThreadAttribute")
            If applicationType Is Nothing OrElse staType Is Nothing Then
                Exit Sub
            End If

            context.RegisterSymbolAction(Sub(c As SymbolAnalysisContext) StaThreadAnalyzer.AnalyzeMethod(c, staType, mtaType), SymbolKind.Method)
        End Sub

        ''' <summary>
        ''' Reports an entry point candidate that is not marked with <c>&lt;STAThread&gt;</c> or <c>&lt;MTAThread&gt;</c>.
        ''' </summary>
        ''' 
        ''' <param name="context">
        ''' The symbol analysis context.
        ''' </param>
        ''' 
        ''' <param name="staType">
        ''' The <see cref="STAThreadAttribute"/> type symbol.
        ''' </param>
        ''' 
        ''' <param name="mtaType">
        ''' The <see cref="MTAThreadAttribute"/> type symbol. May be <see langword="Nothing"/>.
        ''' </param>
        Private Shared Sub AnalyzeMethod(context As SymbolAnalysisContext, staType As INamedTypeSymbol, mtaType As INamedTypeSymbol)

            Dim method As IMethodSymbol = DirectCast(context.Symbol, IMethodSymbol)
            If Not StaThreadAnalyzer.IsEntryPointCandidate(method) OrElse method.Locations.IsEmpty OrElse Not method.Locations(0).IsInSource Then
                Exit Sub
            End If

            Dim marked As Boolean = method.GetAttributes().Any(
                Function(a As AttributeData) SymbolEqualityComparer.Default.Equals(a.AttributeClass, staType) OrElse
                                             (mtaType IsNot Nothing AndAlso SymbolEqualityComparer.Default.Equals(a.AttributeClass, mtaType)))
            If Not marked Then
                context.ReportDiagnostic(Diagnostic.Create(DevCaseDescriptors.MissingStaThread, method.Locations(0), $"{method.ContainingType.Name}.{method.Name}"))
            End If
        End Sub

        ''' <summary>
        ''' Determines whether a method has the shape of a Visual Basic entry point.
        ''' </summary>
        ''' 
        ''' <param name="method">
        ''' The method.
        ''' </param>
        ''' 
        ''' <returns>
        ''' <see langword="True"/> if the method can be the entry point of the program; otherwise, <see langword="False"/>.
        ''' </returns>
        Private Shared Function IsEntryPointCandidate(method As IMethodSymbol) As Boolean

            If method.MethodKind <> MethodKind.Ordinary OrElse Not method.IsStatic OrElse method.IsGenericMethod OrElse
               Not method.Name.Equals("Main", StringComparison.OrdinalIgnoreCase) OrElse method.ContainingType.IsGenericType Then
                Return False
            End If
            If Not method.ReturnsVoid AndAlso method.ReturnType.SpecialType <> SpecialType.System_Int32 Then
                Return False
            End If
            If method.Parameters.Length = 0 Then
                Return True
            End If

            Dim arrayType As IArrayTypeSymbol = TryCast(method.Parameters(0).Type, IArrayTypeSymbol)
            Return method.Parameters.Length = 1 AndAlso arrayType IsNot Nothing AndAlso arrayType.Rank = 1 AndAlso
                   arrayType.ElementType.SpecialType = SpecialType.System_String
        End Function

#End Region

    End Class

End Namespace

#End Region
