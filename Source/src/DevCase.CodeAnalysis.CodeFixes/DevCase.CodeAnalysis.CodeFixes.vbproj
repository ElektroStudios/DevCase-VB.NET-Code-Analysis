<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>DevCase.CodeAnalysis.CodeFixes</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic.Workspaces" Version="$(RoslynVersion)" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Referenced as a library and as an analyzer: the DCA rules are enforced on this project when it is built. -->
    <ProjectReference Include="..\DevCase.CodeAnalysis.Analyzers\DevCase.CodeAnalysis.Analyzers.vbproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DevCase.CodeAnalysis.Tests" />
  </ItemGroup>

</Project>
