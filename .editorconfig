root = true

[*.vb]
indent_style = space
indent_size = 4

# ----------------------------------------------------------------------------
# DevCase VB.NET Code Analysis options
# ----------------------------------------------------------------------------

# DCA010 (Flags enums without bit-shift format) is DISABLED by default because of
# legacy P/Invoke flag enums. Enable it per project (or per folder) with:
# devcase_analyzers.dca010_enabled = true

# DCA001 code fix: emit ConfigureAwait(continueOnCapturedContext:=False) instead of ConfigureAwait(False).
# devcase_analyzers.configure_await_named_argument = true

# DCA006 code fix: namespace used to wrap types declared in the global namespace.
# When not set, the fix uses the namespace already declared in the file, or else the assembly name.
# devcase_analyzers.default_namespace = Contoso.Tools

# DCA011 code fix: conditional compilation symbol of the throw-helper branch.
# Use NET8_0_OR_GREATER when the project also targets .NET 5-7 (some helpers only exist since .NET 8).
# devcase_analyzers.dca011_condition = NETCOREAPP

# DCA017 code fix: match timeout (milliseconds) added to Regex calls. Default: 30000 (TimeSpan.FromSeconds(30)).
# devcase_analyzers.dca017_timeout_ms = 30000

# Standard Roslyn severity overrides also work, e.g.:
# dotnet_diagnostic.DCA007.severity = suggestion
# dotnet_diagnostic.DCA009.severity = none

# ----------------------------------------------------------------------------
# Code style of this repository's own source code
# ----------------------------------------------------------------------------
# The DCA rules are applied to the CodeFixes and Tests projects at build time (see their .vbproj files).
# The following built-in suggestions are raised to warnings so that they are also reported on command-line builds.

# DCA rules whose default severity is Info since version 1.0.8 but that this repository enforces at build time, as
# before: style, documentation and micro-performance rules are suggestions for users, but requirements here.
dotnet_diagnostic.DCA003.severity = warning
dotnet_diagnostic.DCA005.severity = warning
dotnet_diagnostic.DCA007.severity = warning
dotnet_diagnostic.DCA008.severity = warning
dotnet_diagnostic.DCA009.severity = warning
dotnet_diagnostic.DCA010.severity = warning
dotnet_diagnostic.DCA012.severity = warning
dotnet_diagnostic.DCA018.severity = warning
dotnet_diagnostic.DCA019.severity = warning
dotnet_diagnostic.DCA021.severity = warning
dotnet_diagnostic.DCA022.severity = warning
dotnet_diagnostic.DCA023.severity = warning
dotnet_diagnostic.DCA025.severity = warning
dotnet_diagnostic.DCA026.severity = warning
dotnet_diagnostic.DCA033.severity = warning

dotnet_diagnostic.IDE0004.severity = warning
dotnet_diagnostic.IDE0031.severity = warning
dotnet_diagnostic.IDE0045.severity = warning
dotnet_diagnostic.IDE0046.severity = warning
dotnet_diagnostic.IDE0059.severity = warning
dotnet_diagnostic.IDE0060.severity = warning
dotnet_diagnostic.IDE0084.severity = warning
dotnet_diagnostic.IDE0140.severity = warning
dotnet_diagnostic.IDE0270.severity = warning
dotnet_diagnostic.CA1510.severity = warning
dotnet_diagnostic.CA1861.severity = warning
